<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Warnings are errors: this app handles money, and a nullability or
         conversion warning here is a defect, not a style note. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Publishes as a single self-contained folder with no .NET runtime to
         install or patch on the server. ReadyToRun trades a larger artifact for
         a ~50 ms start, so a service restart never lands on a customer. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <UserSecretsId>waterhouse-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately minimal. Every package here is one more thing to patch.
         Cookie auth, JSON, logging and configuration are all in the framework. -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <!-- Pinned to the same 10.0.11 as the installed ASP.NET Core runtime. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />

    <!-- Transitive pin, not a direct dependency of this code.
         Microsoft.Data.Sqlite 10.0.11 resolves SQLitePCLRaw 2.1.11, which
         carries a known high-severity advisory (GHSA-2m69-gcr7-jv3q). NuGet
         audit flags it and TreatWarningsAsErrors turns that into a build
         failure, which is the behaviour we want. Raising it here takes the
         patched build instead of silencing the warning.
         Revisit when Microsoft.Data.Sqlite ships with a newer default. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations ship inside the binary so a deployment can never be missing
         a schema file, and so the migrator cannot run a half-copied folder. -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built React app is copied here by scripts/build.ps1 and served as
         static files from the same origin: no CORS, no second host, no CDN. -->
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
